  PackagerLibs/AceConfig-3.0/AceConfigDialog-3.0:
    url: https://www.wowace.com/projects/ace3/files
    tag: latest-stable
    path: Ace3/AceConfig-3.0/AceConfigDialog-3.0
  PackagerLibs/AceGUI-3.0-SharedMediaWidgets:
    url: https://www.wowace.com/projects/ace-gui-3-0-shared-media-widgets/files
    tag: latest-stable
    path: AceGUI-3.0-SharedMediaWidgets
  PackagerLibs/LibDataBroker-1.1:
