package-as: PleebUI
enable-nolib-creation: no

# NumyAceEvent has no published releases; package its committed copy.
externals:
  # The release workflow resolves latest-stable from published release metadata.
  PackagerLibs/LibStub:
    url: https://www.wowace.com/projects/libstub/files
    tag: latest-stable
    path: LibStub
  PackagerLibs/LibEditModeOverride:
    url: https://www.curseforge.com/api/v1/mods/699543/files
    tag: latest-stable
    path: LibEditModeOverride
  PackagerLibs/oUF:
    url: https://github.com/oUF-wow/oUF.git
    tag: latest-stable
  PackagerLibs/AceGUI-3.0:
    url: https://www.wowace.com/projects/ace3/files
    tag: latest-stable
    path: Ace3/AceGUI-3.0
  PackagerLibs/CallbackHandler-1.0:
    url: https://www.wowace.com/projects/callbackhandler/files
    tag: latest-stable
    path: CallbackHandler-1.0/CallbackHandler-1.0
  PackagerLibs/LibSharedMedia-3.0:
    url: https://www.wowace.com/projects/libsharedmedia-3-0/files
    tag: latest-stable
    path: LibSharedMedia-3.0/LibSharedMedia-3.0
  PackagerLibs/LibCustomGlow-1.0:
    url: https://www.curseforge.com/api/v1/mods/302151/files
    tag: latest-stable
    path: LibCustomGlow-1.0
  PackagerLibs/AceSerializer-3.0:
    url: https://www.wowace.com/projects/ace3/files
    tag: latest-stable
    path: Ace3/AceSerializer-3.0
  PackagerLibs/AceAddon-3.0:
    url: https://www.wowace.com/projects/ace3/files
    tag: latest-stable
    path: Ace3/AceAddon-3.0
  PackagerLibs/LibDeflate:
    url: https://www.curseforge.com/api/v1/mods/293814/files
    tag: latest-stable
    path: LibDeflate
  PackagerLibs/LibDualSpec-1.0:
    url: https://www.wowace.com/projects/libdualspec-1-0/files
    tag: latest-stable
    path: LibDualSpec-1.0
  PackagerLibs/AceDB-3.0:
